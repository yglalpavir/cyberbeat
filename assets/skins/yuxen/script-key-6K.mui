#Made by Lowwy
#do not use the scripts without permission.
@version 4.3.6
@include base.mui
@texpack Yassets



#change the value on "@define HITPOSITION" to modify the Hit Position, a higher number moves the hit position up. (from 37 to 200) (I do not recommend exceeding 150).
#you can use decimal numbers, for example: 72.7
#(default Hitpos: 72.5)

@define HITPOSITION 72.5







#from here you have nothing to see or do, go away.

_bg
    tex=Ybg.png
    size=630,100%
    pos=50%,0
    zindex=0
    anchor=7

bar
    anchor=4
    size=630+40,5
    pos=50%,100%+25
    pos2=50%,{HITPOSITION}-25
    zindex=1
    tex=Ybar6k.png

_receptors-[1-6]
    size=100,50
    pos=50%-262.5$105,{HITPOSITION}
    zindex=8
    anchor=4
    opacity=10
_receptors-[1,3,4,6]
    tex=Ynote1.png
_receptors-[2,5]
    tex=Ynote2.png

#size Xx4 = size Y
press-[1-6]
    anchor=7
    frame=Ypress/0-0
    frame2=Ypress/0-9
    size=100,400
    pos=50%-262.5$105,{HITPOSITION}-25
    zindex=9
    interval=10
    opacity=35
press-[1,3,4,6]
    color=#947FFF
press-[2,5]
    color=#C9BFFF

#size Xx3 = size Y
key-[1-6]
    anchor=1
    tex2=YhintP.png
    size=100,300
    pos=50%-262.5$105,{HITPOSITION}-25
    zindex=21
key-[1,3,4,6]
    tex=Yhint1.png
key-[2,5]
    tex=Yhint2.png

_bottom-[1-6]
    size=100,50+{HITPOSITION}-25
    pos=50%-262.5$105,-55
    zindex=20
    anchor=7
_bottom-[1,3,4,6]
    tex=Ybottom1.png
_bottom-[2,5]
    tex=Ybottom2.png

_hide
    tex=Ybg.png
    size=630,50+{HITPOSITION}-25
    pos=50%,-55
    zindex=11
    anchor=7

note-[1-6]
    anchor=4
    type=2
    tex2=YnoteL.png
    tex3=YnoteT.png
    size=100,50
    pos=50%-262.5$105,100%+52.5
	pos2=50%-262.5$105,{HITPOSITION}
    toggle=1
    zindex=10
note-[1,3,4,6]
    tex=Ynote1.png
note-[2,5]
    tex=Ynote2.png

hit-[1-6]
    anchor=4
    frame=Ynothing/0-0
    size=100,50
    pos=50%-262.5$105,{HITPOSITION}
    zindex=15
    interval=20
hit-[1,3,4,6]
    frame2=Yhold1/0-0
    frame3=Yhold1/0-0
hit-[2,5]
    frame2=Yhold2/0-0
    frame3=Yhold2/0-0

touch
     type=1
     rect=0,0,16.6666666667%,100%
	 rect2=16.6666666667%,0,16.6666666667%,100%
	 rect3=33.3333333334%,0,16.6666666667%,100%
     rect4=50.0000000001%,0,16.6666666667%,100%
     rect5=66.6666666668%,0,16.6666666667%,100%
     rect6=83.3333333335%,0,16.6666666667%,100%