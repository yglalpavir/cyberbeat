#Made by Lowwy
#do not use the scripts without permission.
@version 4.3.6
@include base.mui
@texpack Yassets



#change the value on "@define HITPOSITION" to modify the Hit Position, a higher number moves the hit position up. (from 37 to 200) (I do not recommend exceeding 150).
#you can use decimal numbers, for example: 72.7
#(default Hitpos: 72.5)

@define HITPOSITION 72.5







#from here you have nothing to see or do, go away.

_bg
    tex=Ybg.png
    size=735,100%
    pos=50%,0
    zindex=0
    anchor=7

bar
    anchor=4
    size=735+40,5
    pos=50%,100%+25
    pos2=50%,{HITPOSITION}-25
    zindex=1
    tex=Ybar7k.png

_receptors-[1-7]
    size=100,50
    pos=50%-315$105,{HITPOSITION}
    zindex=8
    anchor=4
    opacity=10
_receptors-[1,3,5,7]
    tex=Ynote1.png
_receptors-[2,6]
    tex=Ynote2.png
_receptors-[4]
    tex=Ynote3.png

#size Xx4 = size Y
press-[1-7]
    anchor=7
    frame=Ypress/0-0
    frame2=Ypress/0-9
    size=100,400
    pos=50%-315$105,{HITPOSITION}-25
    zindex=9
    interval=10
    opacity=35
press-[1,3,5,7]
    color=#947FFF
press-[2,6]
    color=#C9BFFF
press-[4]
    color=#FFBFFF

#size Xx3 = size Y
key-[1-7]
    anchor=1
    tex2=YhintP.png
    size=100,300
    pos=50%-315$105,{HITPOSITION}-25
    zindex=21
key-[1,3,5,7]
    tex=Yhint1.png
key-[2,6]
    tex=Yhint2.png
key-[4]
    tex=Yhint3.png

_bottom-[1-7]
    size=100,50+{HITPOSITION}-25
    pos=50%-315$105,-55
    zindex=20
    anchor=7
_bottom-[1,3,5,7]
    tex=Ybottom1.png
_bottom-[2,6]
    tex=Ybottom2.png
_bottom-[4]
    tex=Ybottom3.png

_hide
    tex=Ybg.png
    size=735,50+{HITPOSITION}-25
    pos=50%,-55
    zindex=11
    anchor=7

note-[1-7]
    anchor=4
    type=2
    tex2=YnoteL.png
    tex3=YnoteT.png
    size=100,50
    pos=50%-315$105,100%+52.5
	pos2=50%-315$105,{HITPOSITION}
    toggle=1
    zindex=10
note-[1,3,5,7]
    tex=Ynote1.png
note-[2,6]
    tex=Ynote2.png
note-[4]
    tex=Ynote3.png

hit-[1-7]
    anchor=4
    frame=Ynothing/0-0
    size=100,50
    pos=50%-315$105,{HITPOSITION}
    zindex=15
    interval=20
hit-[1,3,5,7]
    frame2=Yhold1/0-0
    frame3=Yhold1/0-0
hit-[2,6]
    frame2=Yhold2/0-0
    frame3=Yhold2/0-0
hit-[4]
    frame2=Yhold3/0-0
    frame3=Yhold3/0-0

touch
     type=1
	 rect=0,0,14.2857142857%,100%
	 rect2=14.2857142857%,0,14.2857142857%,100%
	 rect3=28.5714285714%,0,14.2857142857%,100%
     rect4=42.8571428571%,0,14.2857142857%,100%
     rect5=57.1428571428%,0,14.2857142857%,100%
     rect6=71.4285714285%,0,14.2857142857%,100%
     rect7=85.7142857142%,0,14.2857142857%,100%